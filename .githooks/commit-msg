#!/bin/sh
# Forward-only URID linkage check (PHASE0.7 §2).
# Warns when a commit message is missing a [URID_PRODUCT_YEAR_NNNN] reference
# (ideally with a [WI-...] work-item tag, e.g. "[URID_EDU_2026_0042][WI-317] ...").
# Non-blocking by default; set URID_ENFORCE=1 to reject commits without it.
#
# Enable once per clone:   git config core.hooksPath .githooks

first_line=$(head -n1 "$1")
case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if printf '%s' "$first_line" | grep -qE 'URID_[A-Z]{2,6}_[0-9]{4}_[0-9]{4}'; then
  exit 0
fi

echo "commit-msg WARNING: no URID reference found in the subject." >&2
echo "  Expected e.g.  [URID_EDU_2026_0042][WI-317] Short summary" >&2
echo "  Adding it links this commit to the requirement's timeline (AdminPlatform)." >&2
if [ "${URID_ENFORCE:-0}" = "1" ]; then
  echo "  URID_ENFORCE=1 set -> rejecting commit." >&2
  exit 1
fi
exit 0
